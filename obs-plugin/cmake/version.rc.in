// File properties of obs-phonecam.dll (Explorer: Properties > Details). Values come from project(VERSION) in CMakeLists.txt. ASCII only: rc.exe reads the system code page.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CamNeuron"
      VALUE "FileDescription", "CamNeuron PC plugin (Android phone camera source)"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "CamNeuron"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "OriginalFilename", "obs-phonecam.dll"
      VALUE "LegalCopyright", "GPL-2.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
